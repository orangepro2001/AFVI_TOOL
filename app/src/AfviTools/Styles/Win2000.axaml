<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:AfviTools.Controls">
  <Styles.Resources>
    <!-- Windows 2000 tokens (light), from the win2000-style skill: design-tokens.md -->
    <Color x:Key="W2KFace">#D4D0C8</Color>
    <Color x:Key="W2KHighlight">#FFFFFF</Color>
    <Color x:Key="W2KLight">#E8E5DE</Color>
    <Color x:Key="W2KShadow">#808080</Color>
    <Color x:Key="W2KDkShadow">#404040</Color>
    <Color x:Key="W2KSelect">#0A246A</Color>
    <Color x:Key="W2KRowSelect">#A6B8D6</Color>
    <Color x:Key="W2KWarn">#806000</Color>
    <Color x:Key="W2KOk">#008000</Color>
    <Color x:Key="W2KNg">#C00000</Color>
    <SolidColorBrush x:Key="W2KFaceBrush" Color="{StaticResource W2KFace}" />
    <SolidColorBrush x:Key="W2KHighlightBrush" Color="{StaticResource W2KHighlight}" />
    <SolidColorBrush x:Key="W2KLightBrush" Color="{StaticResource W2KLight}" />
    <SolidColorBrush x:Key="W2KShadowBrush" Color="{StaticResource W2KShadow}" />
    <SolidColorBrush x:Key="W2KDkShadowBrush" Color="{StaticResource W2KDkShadow}" />
    <SolidColorBrush x:Key="W2KWarnBrush" Color="{StaticResource W2KWarn}" />
    <SolidColorBrush x:Key="W2KOkBrush" Color="{StaticResource W2KOk}" />
    <SolidColorBrush x:Key="W2KNgBrush" Color="{StaticResource W2KNg}" />
  <!-- group box: etched frame (Highlight ring +1,+1 under a Shadow ring), title at x+10 on a Face gap -->
  <ControlTheme x:Key="{x:Type c:GroupBox}" TargetType="c:GroupBox">
    <Setter Property="Padding" Value="8,6,8,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.RowSpan="2" Margin="0,7,0,0">
            <Border BorderBrush="{StaticResource W2KHighlightBrush}" BorderThickness="1" Margin="1,1,0,0" />
            <Border BorderBrush="{StaticResource W2KShadowBrush}" BorderThickness="1" Margin="0,0,1,1" />
          </Grid>
          <ContentPresenter Grid.Row="0" Content="{TemplateBinding Header}" Background="{StaticResource W2KFaceBrush}"
                            Margin="10,0,0,0" Padding="3,0" HorizontalAlignment="Left" />
          <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" Margin="1,0,1,1" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  </Styles.Resources>

  <!-- Tahoma, then Microsoft YaHei, then Malgun Gothic; Linux falls back to Noto Sans CJK / DejaVu. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource W2KFont}" />
    <Setter Property="FontSize" Value="{DynamicResource W2KFontSize}" />
  </Style>


  <!-- the Classic menu bar has a fixed item height; let it grow with the font size -->
  <Style Selector="Menu > MenuItem">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="MinHeight" Value="20" />
  </Style>

  <!-- status bar pane: single sunken ring (Shadow top/left, Highlight bottom/right) -->
  <Style Selector="Border.pane">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource W2KShadowBrush}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource W2KDkShadowBrush}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{StaticResource W2KWarnBrush}" />
  </Style>
  <Style Selector="TextBlock.ng">
    <Setter Property="Foreground" Value="{StaticResource W2KNgBrush}" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{StaticResource W2KOkBrush}" />
  </Style>
</Styles>
