<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AfviTools.Localization"
             xmlns:c="using:AfviTools.Controls"
             xmlns:vm="using:AfviTools.ViewModels"
             x:Class="AfviTools.Views.ExportView"
             x:DataType="vm:MainViewModel">
  <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Left" Width="520">
    <c:GroupBox Header="{loc:T gb_export}">
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" Text="{loc:T export_page_text}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:T btn_export}" MinWidth="75" Command="{Binding ExportExcelCommand}" />
        </StackPanel>
      </StackPanel>
    </c:GroupBox>
  </StackPanel>
</UserControl>
