<classic:ClassicWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AfviTools.Localization"
        xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
        xmlns:c="using:AfviTools.Controls"
        xmlns:vm="using:AfviTools.ViewModels"
        xmlns:m="using:AfviTools.Models"
        x:Class="AfviTools.Views.MachinesWindow"
        x:DataType="vm:MachinesViewModel"
        Title="{loc:T mach_title}" Width="820" Height="470" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="{loc:T btn_close}" MinWidth="90" IsCancel="True" IsDefault="True" Click="OnClose" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap"
               Classes.ng="{Binding IsError}" />

    <Grid ColumnDefinitions="220,8,*">
      <c:GroupBox Header="{loc:T gb_machines}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
            <Button Content="{loc:T btn_new}" HorizontalAlignment="Stretch" Command="{Binding NewCommand}" />
            <Button Content="{loc:T btn_delete}" HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}" />
            <Button Content="{loc:T btn_restore}" HorizontalAlignment="Stretch" Command="{Binding RestoreDefaultCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:MachineDto">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </c:GroupBox>

      <c:GroupBox Grid.Column="2" Header="{Binding EditorTitle}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="60,*">
            <TextBlock Text="{loc:T lbl_name}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Draft.Name}" />
          </Grid>
          <Grid ColumnDefinitions="60,150,8,*,8,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="0" RowSpacing="6">
            <TextBlock Grid.Column="1" Text="{loc:T col_host}" Classes="dim" />
            <TextBlock Grid.Column="3" Text="{loc:T col_repo_path}" Classes="dim" />
            <TextBlock Grid.Column="5" Text="{loc:T col_inv_path}" Classes="dim" />

            <TextBlock Grid.Row="1" Text="FM1" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.Fm1.Host}" />
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Draft.Fm1.RepositoryPath}" />
            <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Draft.Fm1.InventoryPath}" />

            <TextBlock Grid.Row="2" Text="FM2" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Draft.Fm2.Host}" />
            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Draft.Fm2.RepositoryPath}" />
            <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding Draft.Fm2.InventoryPath}" />

            <TextBlock Grid.Row="3" Text="BM" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Draft.Bm.Host}" />
            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Draft.Bm.RepositoryPath}" />
            <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding Draft.Bm.InventoryPath}" />
          </Grid>
          <TextBlock Classes="dim" TextWrapping="Wrap" Text="{loc:T mach_note}" />
          <Button Content="{loc:T btn_save}" HorizontalAlignment="Right" MinWidth="90" Command="{Binding SaveCommand}" />
        </StackPanel>
      </c:GroupBox>
    </Grid>
  </DockPanel>
</classic:ClassicWindow>
