<classic:ClassicWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AfviTools.Localization"
        xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
        xmlns:vm="using:AfviTools.ViewModels"
        xmlns:v="using:AfviTools.Views"
        x:Class="AfviTools.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AFVI TOOLS" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{loc:T menu_file}">
        <MenuItem Header="{loc:T menu_machines}" Command="{Binding EditMachinesCommand}" />
        <MenuItem Header="{loc:T menu_refresh}" InputGesture="F5" Command="{Binding RefreshCommand}" />
        <Separator />
        <MenuItem Header="{loc:T menu_exit}" Click="OnExit" InputGesture="Alt+F4" />
      </MenuItem>
      <MenuItem Header="{loc:T menu_view}">
        <MenuItem Header="{loc:T menu_fontsize}" Name="FontMenu" />
        <MenuItem Header="{loc:T menu_language}" Name="LanguageMenu" />
      </MenuItem>
      <MenuItem Header="{loc:T menu_tools}">
        <MenuItem Header="{loc:T menu_export}" Command="{Binding ExportExcelCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:T menu_help}">
        <MenuItem Header="{loc:T menu_about}" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- status bar: sunken panes, the first takes the remaining width -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="2,0,2,2">
      <Border Classes="pane" Grid.Column="0"><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" /></Border>
      <Border Classes="pane" Grid.Column="1"><TextBlock Text="{Binding PathText}" /></Border>
      <Border Classes="pane" Grid.Column="2"><TextBlock Text="{Binding CountText}" /></Border>
      <Border Classes="pane" Grid.Column="3" Margin="0"><TextBlock Text="{Binding LockText}" /></Border>
    </Grid>

    <TabControl Margin="4,4,4,4">
      <TabItem Header="{loc:T tab_copy}">
        <v:ModelCopyView />
      </TabItem>
      <TabItem Header="{loc:T tab_export}">
        <v:ExportView />
      </TabItem>
    </TabControl>
  </DockPanel>
</classic:ClassicWindow>
