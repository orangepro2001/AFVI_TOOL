<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AfviTools/AfviTools.csproj" />
  </ItemGroup>

  <!-- the tests start bin/afvi-core: rebuild it so they never run against a stale core -->
  <Target Name="BuildCore" BeforeTargets="BeforeBuild" Condition="'$(AFVI_CORE)' == ''">
    <Exec Command="go build -o ../bin/afvi-core ./cmd/afvi-core" WorkingDirectory="$(MSBuildThisFileDirectory)../../../core" ContinueOnError="false" />
  </Target>

</Project>
